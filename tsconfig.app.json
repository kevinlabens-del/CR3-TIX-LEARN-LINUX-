{
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false, "allowImportingTsExtensions": true },
  "include": [
    "app/page.tsx",
    "app/layout.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "github/**/*.tsx",
    "tests/**/*.ts",
    "vite.github.config.ts"
  ],
  "exclude": ["node_modules", "dist", "gh-pages-dist"]
}
